<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF0C1022" android:endColor="#FF05070F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="70%p"
                android:centerX="0.1" android:centerY="0.0"
                android:startColor="#556C5CE7" android:endColor="#006C5CE7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="60%p"
                android:centerX="1.0" android:centerY="1.0"
                android:startColor="#3300B4FF" android:endColor="#0000B4FF" />
        </shape>
    </item>
</layer-list>
